user root;
worker_processes 1;
error_log /dev/stderr warn;
pid /run/nginx.pid;

events { worker_connections 512; }

http {
    include       /etc/nginx/mime.types;
    # O bucket padrão (64) não comporta o token do VNC no map abaixo
    map_hash_bucket_size 128;
    access_log    off;
    sendfile      on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # O navegador não manda credencial de basic auth no handshake de WebSocket,
    # então o socket do VNC é autenticado por token na query string.
    map $arg_token $vnc_token_ok {
        "${VNC_TOKEN}" 1;
        default        0;
    }

    server {
        listen ${PORT};

        auth_basic           "ifood-tracker";
        auth_basic_user_file /etc/nginx/.htpasswd;

        # Socket do VNC: sem basic auth, protegido pelo token
        location = /vnc/websockify {
            auth_basic off;
            if ($vnc_token_ok = 0) { return 403; }

            proxy_pass http://127.0.0.1:6080/websockify;
            proxy_http_version 1.1;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host       $host;
            proxy_read_timeout 3600s;
        }

        # noVNC — janela do Chrome do container, para login manual no iFood
        location /vnc/ {
            proxy_pass http://127.0.0.1:6080/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host       $host;
            proxy_read_timeout 3600s;
        }

        # Streamlit
        location / {
            proxy_pass http://127.0.0.1:8501;
            proxy_http_version 1.1;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host       $host;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;
            proxy_buffering off;
        }
    }
}
